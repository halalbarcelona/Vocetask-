# Supabase project config for the premium-status backend.
#
# The anon key is meant to be public — it ships in every client's JS bundle
# regardless of where it's read from. Row Level Security on premium_status is
# the actual security boundary (read-open, no write policy at all: only the
# stripe-webhook Edge Function's service_role key can write). Safe to commit.
#
# Never put the service_role key here or anywhere in this repo — it bypasses
# RLS and lives only in the Edge Function's own secret store.
VITE_SUPABASE_URL=https://ogrhsphixhgkbpdlzfks.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im9ncmhzcGhpeGhna2JwZGx6ZmtzIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODc0MDAzNjIsImV4cCI6MjEwMjk3NjM2Mn0.s6A9n4T53UUxTEScH4CKMVsr4zpXWBNyGdoBWOQD61c

# Web Push VAPID public key (see supabase/functions/send-reminders/). Public
# keys are meant to ship in the client, same reasoning as the anon key above —
# the matching private key lives only in the Edge Function's secret store,
# generated once via `npx web-push generate-vapid-keys` and never committed.
VITE_VAPID_PUBLIC_KEY=BLcJLv6rgXv3SvaX71TXTBKSaLHABmrKlS3ZgvMRcASsIwIR9UUeM_bWl54fA23oBrriZSV617Blp_O1nOznD6w
